{
  "expo": {
    "name": "getit",
    "slug": "bolo",
    "scheme": "bolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#171615",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "cm.bolo.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "getit uses your location to show workers and jobs near you.",
        "NSCameraUsageDescription": "getit uses the camera for your profile photo, ID check and job photos.",
        "NSPhotoLibraryUsageDescription": "getit lets you pick photos for your profile, jobs and chats.",
        "NSMicrophoneUsageDescription": "getit uses the microphone for voice messages and calls.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cm.bolo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-mono.png",
        "backgroundColor": "#ff3b1f"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#171615"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "getit lets you pick photos for your profile, jobs and chats.",
          "cameraPermission": "getit uses the camera for your profile photo, ID check and job photos.",
          "microphonePermission": "getit uses the microphone for voice messages and calls."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "getit uses your location to show workers and jobs near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "packagingOptions": {
              "exclude": [
                "**/libagora_lip_sync_extension.so",
                "**/libagora_clear_vision_extension.so",
                "**/libagora_spatial_audio_extension.so",
                "**/libagora_face_capture_extension.so",
                "**/libagora_face_detection_extension.so",
                "**/libagora_segmentation_extension.so",
                "**/libagora_content_inspect_extension.so",
                "**/libagora_video_quality_analyzer_extension.so",
                "**/libagora_video_av1_encoder_extension.so",
                "**/libagora_screen_capture_extension.so",
                "**/libagora_audio_beauty_extension.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withAbiSplits",
      "./plugins/withIncomingCall",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff3b1f",
          "defaultChannel": "messages",
          "sounds": [
            "./assets/sounds/bolo_ring.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
